{
  "name": "sdk-automation",
  "version": "0.1.0",
  "description": "SDK Automation POC - Generate and publish SDKs across 7 languages",
  "private": true,
  "scripts": {
    "validate-spec": "openapi-spec-validator apis/spec-v2.openapi.yaml",
    "check-breaking-changes": "python3 tools/breaking-change-detector.py",
    "test": "jest",
    "test:watch": "jest --watch",
    "generate-sdks": "make generate",
    "start": "npm run check-breaking-changes"
  },
  "keywords": [
    "sdk",
    "automation",
    "openapi",
    "code-generation"
  ],
  "author": "Antonio Silva",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@openapitools/openapi-generator-cli": "^2.41.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "tests/**/*.test.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "proxy-agent": "^6.4.0",
    "concurrently": "^9.2.4"
  }
}
